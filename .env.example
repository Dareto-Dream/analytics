PUBLIC_URL=https://analytics.deltavdevs.com
DATABASE_URL=postgres://user:pass@localhost:5432/analytics
# At least 32 characters. Signs sessions and seals Ward refresh tokens.
SESSION_SECRET=
# Ward app for "Continue with Ward" (scopes: openid profile email admin offline_access).
WARD_URL=https://ward.deltavdevs.com
WARD_CLIENT_ID=
WARD_CLIENT_SECRET=
# Railway account token, to read request logs from every project.
RAILWAY_API_TOKEN=
